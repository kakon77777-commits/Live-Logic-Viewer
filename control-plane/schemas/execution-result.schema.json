{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/live-logic/execution-result.schema.json",
  "title": "Live Logic Execution Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "status", "execution", "result", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "request_id": {"type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "received_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "status": {"enum": ["completed", "failed"]},
    "execution": {"type": "object", "additionalProperties": false, "required": ["provider", "runner", "exit_code", "timed_out", "wall_ms"], "properties": {"provider": {"type": "string", "minLength": 1, "maxLength": 64}, "runner": {"const": "python"}, "exit_code": {"type": ["integer", "null"]}, "timed_out": {"type": "boolean"}, "wall_ms": {"type": "integer", "minimum": 0}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["type", "stdout", "stderr", "truncated"], "properties": {"type": {"const": "text"}, "stdout": {"type": "string", "maxLength": 65536}, "stderr": {"type": "string", "maxLength": 65536}, "truncated": {"type": "boolean"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["request_sha256", "source_sha256"], "properties": {"request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "signature"], "properties": {"algorithm": {"const": "ECDSA_P256_SHA256"}, "payload_version": {"enum": ["1", "2"]}, "key_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}, "signature": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$"}}}
  },
  "allOf": [
    {
      "if": {"required": ["integrity"], "properties": {"integrity": {"required": ["payload_version"], "properties": {"payload_version": {"const": "2"}}}}},
      "then": {"required": ["request_id", "received_at", "completed_at"]}
    }
  ]
}
